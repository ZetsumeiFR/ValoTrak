{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*.pvp.net/*" },
        { "url": "https://valorant-api.com/*" },
        { "url": "https://riot-geo.pas.si.riotgames.com/*" }
      ]
    }
  ]
}
