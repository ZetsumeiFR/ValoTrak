# ValoTrak server — required environment variables.
# Validated at startup by @valotrak/env (the process exits if any is missing/invalid).

# Neon Postgres connection string.
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# Better-Auth signing secret — MUST be at least 32 characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-32+-char-random-secret"

# Public URL of THIS backend (used by Better-Auth as its base URL).
BETTER_AUTH_URL="https://api.your-domain.com"

# Allowed browser origin (your deployed web frontend). The Tauri desktop
# origins are already trusted in code, so this is for the web app.
CORS_ORIGIN="https://app.your-domain.com"

# Runtime mode.
NODE_ENV="production"

# Port the server listens on (Bun reads PORT automatically).
PORT="3000"

# Retention window (days) for the append-only snapshot history.
SNAPSHOT_RETENTION_DAYS=180
